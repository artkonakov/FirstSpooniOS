    "network_blocked_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is not allowed to use the internet in your phone settings. Without it, sign-in, your account and subscription don't work.\n\nOpen the app settings and allow data usage: \"Mobile data & Wi‑Fi\" or \"Data usage\""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложению запрещено пользоваться интернетом в настройках телефона. Без него не работают вход, сохранение аккаунта и подписка.\n\nОткройте настройки приложения и разрешите передачу данных: «Мобильные данные и Wi‑Fi» или «Передача данных»"
          }
        }
      }
    },
