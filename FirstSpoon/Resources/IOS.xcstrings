    "entry_photos_hint": {
      "comment": "Фото в пробах (то же в Android, ключи совпадают).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rash, redness — or just mealtime. Handy for your pediatrician and a nice keepsake."
