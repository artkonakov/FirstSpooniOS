            "state": "translated",
            "value": "Date of birth"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата рождения"
          }
        }
      }
    },
    "onb_done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "onb_eczema_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eczema raises the risk of food allergy — we'll be more careful with allergens"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При экземе выше риск пищевой аллергии — будем внимательнее к аллергенам"
          }
        }
      }
    },
    "onb_eczema_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does your baby have eczema?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть экзема?"
          }
        }
      }
    },
    "onb_family_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Food allergy, asthma or atopic dermatitis in the family raise the risk — we'll take it into account"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пищевая аллергия, астма или атопический дерматит в семье повышают риск — учтём в рекомендациях"
          }
        }
      }
    },
    "onb_family_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do parents, brothers or sisters have allergies?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть аллергия у родителей, братьев или сестёр?"
          }
        }
      }
    },
    "onb_feeding_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Besides solids"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помимо прикорма"
          }
        }
      }
    },
    "onb_feeding_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What does your baby eat now?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем малыш питается сейчас?"
          }
        }
      }
    },
    "onb_food_interest_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example, they reach for your food while you eat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Например, тянет руки к вашей еде, когда вы едите"
          }
        }
      }
    },
    "onb_food_interest_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does your baby reach for food?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Малыш тянется к еде?"
          }
        }
      }
    },
    "onb_head_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's one of the signs your baby is ready for solids"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это один из признаков, что малыш готов к прикорму"
          }
        }
      }
    },
    "onb_head_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does your baby hold their head up steadily?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Малыш уверенно держит голову?"
          }
        }
      }
    },
    "onb_known_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark the main ones — you can add the rest later in Foods. If you haven't started solids yet, tap Skip"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте основное — остальное можно добавить потом в «Продуктах». Если прикорм ещё не начинали, нажмите «Пропустить»"
          }
        }
      }
    },
    "onb_known_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which foods does %1$@ already eat?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какие продукты %1$@ уже ест?"
          }
        }
      }
    },
    "onb_name_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name will appear on the home screen and in the diary"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя будет на главном экране и в дневнике"
          }
        }
      }
    },
    "onb_name_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's your baby's name?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как зовут малыша?"
          }
        }
      }
    },
    "onb_next": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Далее"
          }
        }
      }
    },
    "onb_result_check_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are signs of readiness for solids. When you see both, mark it on the home screen and we'll suggest first foods"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это признаки готовности к прикорму. Когда заметите оба, отметьте это на главном экране — и мы предложим первые продукты"
          }
        }
      }
    },
    "onb_result_check_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch how %1$@ holds their head and sits"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Понаблюдайте, как %1$@ держит голову и сидит"
          }
        }
      }
    },
    "onb_result_check_title_n": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep an eye on your baby"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Понаблюдайте за малышом"
          }
        }
      }
    },
    "onb_result_not_yet_f": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ isn't ready for solids yet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ пока не готова к прикорму"
          }
        }
      }
    },
    "onb_result_not_yet_m": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ isn't ready for solids yet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ пока не готов к прикорму"
          }
        }
      }
    },
    "onb_result_not_yet_n": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's too early for solids"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К прикорму пока рано"
          }
        }
      }
    },
    "onb_result_not_yet_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll suggest first foods once your baby holds their head up steadily and sits with support. Every baby has their own pace — if in doubt, ask your pediatrician"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первые продукты предложим, когда малыш уверенно держит голову и сидит с поддержкой. У каждого малыша свой темп — если сомневаетесь, спросите педиатра"
          }
        }
      }
    },
    "onb_result_ready_f": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is ready for solids"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ готова к прикорму"
          }
        }
      }
    },
    "onb_result_ready_m": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is ready for solids"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ готов к прикорму"
          }
        }
      }
    },
    "onb_result_ready_n": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can start solids"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно начинать прикорм"
          }
        }
      }
    },
    "onb_result_ready_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with one food and a small portion — we'll suggest what to give first"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начнём с одного продукта и маленькой порции — подскажем, что дать первым"
          }
        }
      }
    },
    "onb_result_started_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll suggest what to try next — one food at a time"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подскажем, что попробовать следующим, — по одному продукту за раз"
          }
        }
      }
    },
    "onb_result_started_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is already exploring food"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
