    "onb_allergens_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark allergens confirmed by a doctor. If there are none, tap \"Next\""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте аллергены, подтверждённые врачом. Если таких нет, нажмите «Далее»"
          }
        }
      }
    },
    "onb_allergens_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any known food allergies?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть известная пищевая аллергия?"
          }
        }
      }
    },
    "onb_birth_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll use the age to suggest which foods are already OK"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По возрасту подскажем, какие продукты уже можно вводить"
          }
        }
      }
    },
    "onb_birth_title": {
      "extractionState": "manual",
      "localizations": {
