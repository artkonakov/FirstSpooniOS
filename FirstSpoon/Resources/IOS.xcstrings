  "strings": {
    "catalog_custom_category": {
      "comment": "Только iOS (в Android — категория из CatalogRepository). Группа своих продуктов без категории.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My products"
          }
        },
        "ru": {
